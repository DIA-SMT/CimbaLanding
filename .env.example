# CIMBA Ciudadano — variables de entorno
# Copiar a .env.local. NUNCA usar el prefijo NEXT_PUBLIC_ para estos valores:
# se leen sólo del lado servidor.

# Modo de datos:
#   demo  → datos de demostración rotulados (desarrollo / staging)
#   live  → API pública oficial de CIMBA (/api/publico/avance)
#   off   → sin datos (estados "no disponible")
# Sin definir: demo en desarrollo, "off" en producción.
# IMPORTANTE: la portada se prerenderiza en el build (ISR 5 min): definirlo también al compilar.
CIMBA_DATA_MODE=demo

# Sólo para CIMBA_DATA_MODE=live. Origen HTTPS de CIMBA. La API pública NO usa
# credenciales y responde 404 hasta que la Dirección prenda AVANCE_PUBLICO=1 en CIMBA.
CIMBA_PUBLIC_API_URL=https://cimba.smt.gob.ar

# Ventana de trabajos que se muestran (días): 1, 7, 30, 90 o 0 (todo). Por defecto 90.
CIMBA_VENTANA_DIAS=90

# Otros orígenes HTTPS desde los que se aceptan fotos (separados por coma), si
# CIMBA guarda fotos fuera de su dominio. Por defecto sólo el de CIMBA.
CIMBA_FOTOS_ORIGENES=

# ── Reclamos: iframe de CiDiTuc ──
# Origen del login que abre el iframe de Reclamos. Vacío = producción
# (ciudaddigital.smt.gob.ar). Para probar con una copia local: http://localhost:5173
# Sólo se aplica fuera de producción.
CIDITUC_LOGIN_BASE=

# ── Reclamos: formulario propio (respaldo del iframe) ──
# El reclamo se carga en el portal y se registra SIEMPRE en CiDiTuc.
#   off | simulado | real   (sin definir: simulado en desarrollo, off en producción)
CIDITUC_RECLAMOS_MODO=simulado
# Backend público de Atención Ciudadana (el mismo que lee CIMBA).
CIDITUC_API_URL=https://estadisticas.smt.gob.ar:8084
# Alta de reclamos: existe POST /reclamos/altaReclamo (multipart, lo usa el
# derivador) pero requiere autorización de DITEC antes de usarse desde el portal.
# Sin ella, el modo "real" se comporta como "off".
CIDITUC_RECLAMOS_ALTA_PATH=
# id_oreclamo (origen) que CiDiTuc asigne a este portal, si corresponde.
CIDITUC_ORIGEN_ID=

# ── Ciudad Digital (identidad del vecino) ──
# Backend que valida ?auth=<token> en GET /usuarios/authStatus. Requiere dar
# de alta el portal como "sistema externo" en Ciudad Digital.
CIUDAD_DIGITAL_API_URL=https://estadisticas.smt.gob.ar:5000
CIUDAD_DIGITAL_PORTAL_URL=https://ciudaddigital.smt.gob.ar/
# Firma de la cookie de sesión del vecino (32+ caracteres). Obligatoria en producción.
CIUDADANO_SESSION_SECRET=
# SÓLO desarrollo: habilita una persona de prueba (ignorado en producción).
CIUDAD_DIGITAL_DEV_PERSONA=1
